# ==============================================================================
# E-Cell Hiring Examination Portal - Production Environment Configuration
# ==============================================================================

# Server Network Binding
# 127.0.0.1 when running behind Nginx / Caddy reverse proxy
# 0.0.0.0 if running standalone or in Docker
ECELL_HOST=127.0.0.1
ECELL_PORT=8000

# Database Storage Location (Default: data/ecell.db relative to project root)
# ECELL_DB=/var/www/ecell-portal/data/ecell.db

# Reverse Proxy & Security Flags
# Set to 1 because Nginx passes X-Forwarded-For (ensures accurate proctor logs)
ECELL_TRUST_PROXY=1

# Set to 1 when serving over HTTPS/SSL (marks cookies as Secure)
ECELL_COOKIE_SECURE=1

# Session lifetime in hours (e.g. 4 hours)
ECELL_SESSION_HOURS=4

# Secret passphrase required to create the first admin via /#/admin
ECELL_ADMIN_SETUP_CODE=Ecell@Hirings2026!

# Allowed Origins (CORS protection - leave empty to only allow same-origin)
ECELL_ALLOWED_ORIGINS=https://exam.yourcollegeecell.com

# Enable minimal terminal logging
ECELL_VERBOSE=0
